.env
# legacy Line A job data (discarded by decision 2026-09-28; delete manually when no longer needed)
output/
# model weights and downloaded metadata: never in Git (see config/models.lock.yaml)
models/checkpoints/*
models/loras/*/*
!models/loras/*/.gitkeep
models/cache/*
models/manifests/
!models/**/.gitkeep
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
web/dist/
web/node_modules/
web/tsconfig.tsbuildinfo
tests/e2e/artifacts/
tests/gpu/artifacts/variants/
# ComfyUI runtime state (advanced UI user data)
comfyui/user/
projects/*
!projects/.gitkeep

# subagent memory notes (local only)
**/.claude/agent-memory/
secrets/
