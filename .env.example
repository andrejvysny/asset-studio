# Copy to .env. Used only by download-models.sh and compose.
# HF token; required for gated facebook/dinov3 (accept license on HF first).
HF_TOKEN=
# Host port for ComfyUI (bound to 127.0.0.1).
COMFYUI_PORT=8188
# CDI device names; `nvidia-ctk cdi list` to inspect.
GPU_IMAGE=nvidia.com/gpu=0
GPU_3D=nvidia.com/gpu=1
# Host port for Asset Studio (bound to 127.0.0.1).
STUDIO_PORT=8190
