# Copy to .env. Machine-specific settings only; never commit credentials.
# HF token for `make models` (gated repos need an approved licence request on huggingface.co first).
HF_TOKEN=
# Host paths mounted into containers.
PROJECTS_DIR=./projects
MODELS_DIR=./models
# Physical GPUs (Docker device ids / CDI indexes). Each container sees its own GPU as cuda:0.
GPU_IMAGE_ID=0
GPU_AUX_ID=1
# Host ports (bound to 127.0.0.1 only).
STUDIO_PORT=8190
COMFYUI_PORT=8188
# comfyui | fake (SIMULATED demo/test engine) | none (library-only)
STUDIO_ENGINE=comfyui
# 3D worker. Empty WORKER3D_URL disables 3D builds. RESEARCH_EXPORTER=1 builds the worker with NVIDIA nvdiffrast
# (research/evaluation-only licence) for the opt-in `exporter: research`; tag it separately, e.g. RESEARCH_EXPORTER_TAG=research.
WORKER3D_URL=http://worker3d:8003
RESEARCH_EXPORTER=0
RESEARCH_EXPORTER_TAG=dev
