# Copy to .env. Machine-specific settings only; never commit credentials.
# HF token for `make models` (gated repos need an approved licence request on huggingface.co first).
HF_TOKEN=
# Host paths mounted into containers.
PROJECTS_DIR=./projects
MODELS_DIR=./models
# Physical GPUs (Docker device ids / CDI indexes). Each container sees its own GPU as cuda:0.
GPU_IMAGE_ID=0
GPU_AUX_ID=1
# Host ports (bound to 127.0.0.1 only).
STUDIO_PORT=8190
COMFYUI_PORT=8188
# MCP endpoint for remote AI agents (bearer tokens: `assetstudio mcp create <name>`). STUDIO_MCP=0 disables it.
# Keep MCP_BIND on loopback and put a TLS reverse proxy/tunnel in front; set STUDIO_MCP_PUBLIC_URL to its URL
# (allowed Host header + base of signed file URLs), e.g. https://studio.example.net
STUDIO_MCP=1
MCP_BIND=127.0.0.1
MCP_PORT=8191
STUDIO_MCP_PUBLIC_URL=
# Godot integration API (separate listener, library-scoped bearer tokens: `assetstudio integration token create`).
# Disabled by default. Binds loopback; to reach it from another machine set INTEGRATION_BIND to a LAN address AND put a
# TLS reverse proxy in front, or (development only, tokens travel in cleartext, a warning is logged)
# STUDIO_INTEGRATION_ALLOW_INSECURE_LAN=1. In the container the bind is governed by the INTEGRATION_BIND mapping.
STUDIO_INTEGRATION_ENABLED=0
INTEGRATION_BIND=127.0.0.1
INTEGRATION_PORT=8192
STUDIO_INTEGRATION_ALLOW_INSECURE_LAN=0
# comfyui | fake (SIMULATED demo/test engine) | none (library-only)
STUDIO_ENGINE=comfyui
# 3D worker. Empty WORKER3D_URL disables 3D builds. RESEARCH_EXPORTER=1 builds the worker with NVIDIA nvdiffrast
# (research/evaluation-only licence) for the opt-in `exporter: research`; tag it separately, e.g. RESEARCH_EXPORTER_TAG=research.
WORKER3D_URL=http://worker3d:8003
RESEARCH_EXPORTER=0
RESEARCH_EXPORTER_TAG=dev
