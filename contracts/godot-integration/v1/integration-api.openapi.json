  "components": {
    "schemas": {
      "AssetRef": {
        "properties": {
          "server_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Server Id"
          },
          "library_id": {
            "type": "string",
            "pattern": "^prj_[0-9a-hjkmnp-tv-z]{16}$",
            "title": "Library Id"
          },
          "asset_id": {
            "type": "string",
            "pattern": "^ast_[0-9a-hjkmnp-tv-z]{16}$",
            "title": "Asset Id"
          },
          "version_id": {
            "type": "string",
            "pattern": "^ver_[0-9a-hjkmnp-tv-z]{16}$",
            "title": "Version Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "server_id",
          "library_id",
          "asset_id",
          "version_id"
        ],
        "title": "AssetRef"
      },
      "CommitPublication": {
        "properties": {
          "preview_id": {
            "type": "string",
            "title": "Preview Id"
          },
          "target_asset_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Asset Id"
          },
          "expected_current_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Current Version"
          },
          "package_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Package Sha256"
          },
          "portable_sha256": {
            "type": "string",
            "title": "Portable Sha256"
          },
          "descriptor_draft_sha256": {
            "type": "string",
            "title": "Descriptor Draft Sha256"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "category_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category Id"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Tags",
            "default": []
          },
          "licence": {
            "type": "string",
            "maxLength": 200,
            "title": "Licence",
            "default": "unknown"
          },
          "source_uri": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Uri"
          },
          "credit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Credit"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "preview_id",
          "portable_sha256",
          "descriptor_draft_sha256",
          "name",
          "idempotency_key"
        ],
        "title": "CommitPublication"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ResolveBody": {
        "properties": {
          "refs": {
            "items": {
              "$ref": "#/components/schemas/AssetRef"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Refs"
          },
          "target": {
            "$ref": "#/components/schemas/Target",
            "default": {
              "representations": [
                "portable_glb_v1"
              ]
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "refs"
        ],
        "title": "ResolveBody"
      },
      "Target": {
        "properties": {
          "representations": {
            "items": {
              "type": "string",
              "enum": [
                "portable_glb_v1",
                "godot_static_source_v1",
                "mobile_glb_v1"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Representations",
            "default": [
              "portable_glb_v1"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Target"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
